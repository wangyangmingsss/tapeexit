    "@types/react-dom": "19.3.0",
    "@uniswap/v3-core": "1.0.0",
    "@uniswap/v3-periphery": "1.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "qrcode": "1.5.4",
    "solc": "0.7.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
