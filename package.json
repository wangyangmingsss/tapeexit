    "build:demo": "vite build --mode demo --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:tapekit": "tsx --test tests/tapekit-compat.test.mjs",
    "test:wallet": "tsx tools/controlled-test.ts",
    "recover:test": "tsx tools/controlled-recovery.ts",
    "verify:test-fork": "tsx tools/verify-controlled-test-fork.ts",
    "verify:deployment": "tsx tools/verify-deployment.ts",
    "verify:publication": "tsx tools/verify-publication.ts",
    "verify:gateways": "tsx tools/verify-gateways.ts",
    "preflight:release": "tsx tools/release-preflight.ts",
    "inspect:publication": "tsx tools/inspect-publication.ts",
    "inspect:tapeout": "tsx tools/inspect-tapeout.ts",
    "rehearse:publication": "tsx tools/rehearse-publication.ts",
    "publish:wallet": "tsx tools/publication-workbench.ts",
    "inspect:assets": "tsx tools/inspect-assets.ts",
    "verify:assets": "tsx tools/verify-assets.ts",
    "verify:runtime-source": "tsx tools/verify-runtime-source.ts",
    "inspect:runtime-metadata": "tsx tools/inspect-runtime-metadata.ts",
    "prepare:review": "tsx tools/prepare-review.ts",
    "verify:review": "tsx tools/verify-review.ts",
    "verify:recovery": "tsx tools/verify-recovery.ts",
    "verify:vault": "tsx tools/verify-spark-vault.ts",
    "verify:vault-fork": "tsx tools/verify-spark-vault.ts --fork",
    "test:vault-wallet": "tsx tools/vault-wallet.ts",
    "verify:vault-wallet-fork": "tsx tools/verify-vault-wallet-fork.ts",
    "prepare:recovery": "tsx tools/prepare-recovery.ts",
    "prepare:acceptance-assets": "tsx tools/prepare-acceptance-assets.ts",
