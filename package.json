{
  "name": "tapeexit",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 4174",
    "build": "tsc --noEmit && vite build && node tools/release.mjs",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:tapekit": "tsx --test tests/tapekit-compat.test.mjs",
    "verify:deployment": "tsx tools/verify-deployment.ts",
    "verify:publication": "tsx tools/verify-publication.ts",
    "inspect:publication": "tsx tools/inspect-publication.ts",
    "inspect:assets": "tsx tools/inspect-assets.ts",
    "accept:wallet": "node tools/wallet-acceptance.mjs",
    "report:users": "node tools/user-validation.mjs",
    "record:demo": "node tools/record-demo.mjs",
    "report:readiness": "tsx tools/report-readiness.ts",
    "package:entry": "tsx tools/package-entry.ts",
    "print:card": "tsx tools/print-recovery-card.ts",
    "verify:fork": "tsx tools/verify-fork.ts",
    "recovery": "node tools/local-server.mjs",
    "gateway": "node tools/gateway.mjs",
    "vendor:tapekit": "node tools/vendor-tapekit.mjs",
    "build:gateway": "node tools/build-gateway.mjs",
    "plan:publish": "tsx tools/publish-plan.ts",
    "plan:resume": "tsx tools/resume-publication.ts",
    "report:dependencies": "node tools/dependency-report.mjs",
    "report:dependency-scope": "node tools/dependency-scope.mjs",
    "verify:reproducibility": "node tools/verify-reproducibility.mjs",
    "check:release": "node tools/check-release.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "tmp": "0.2.7",
    "diff": "8.0.3",
    "serialize-javascript": "7.1.3"
  },
  "dependencies": {
    "@uniswap/sdk-core": "7.20.0",
    "@uniswap/v3-sdk": "3.31.8",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.12"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uniswap/v3-core": "1.0.0",
    "@uniswap/v3-periphery": "1.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "qrcode": "1.5.4",
    "solc": "0.7.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
