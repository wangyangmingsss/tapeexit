  "overrides": {
    "tmp": "0.2.7",
    "diff": "8.0.3",
    "serialize-javascript": "7.1.3",
    "hardhat": {
      "undici": "6.29.1",
      "adm-zip": "0.6.1",
      "uuid": "11.1.1"
    },
    "@sentry/node": {
      "cookie": "0.7.2"
    }
  },
  "dependencies": {
    "@uniswap/sdk-core": "7.20.0",
    "@uniswap/v3-sdk": "3.31.8",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.12"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@openzeppelin/contracts": "3.4.2-solc-0.7",
    "@playwright/test": "1.64.1",
